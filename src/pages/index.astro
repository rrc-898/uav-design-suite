---
import AppShell from '../layouts/AppShell.astro';
import StatCard from '../components/StatCard.astro';
import { MOTORS, PROPS, BATTERIES } from '../lib/catalog';
import { missionPoint, maxStaticThrust, type DriveTrain } from '../lib/propulsion';
import { XC27_LIMITS, XC27_DEADLINES, daysUntil } from '../lib/xc27';

const nextDeadline = XC27_DEADLINES.find((d) => d.kind !== 'evento' && daysUntil(d.date) >= 0);

// Live demo metric: GT2826 + APC10x5 + 4S reference config
const dt: DriveTrain = {
  motor: MOTORS[0], prop: PROPS[0], battery: BATTERIES[0],
  esc: { iMax: 50, efficiency: 0.97, resistance: 0.01 },
};
const stat = maxStaticThrust(dt);
const cruise = missionPoint(dt, 0.55, 16);

const projects = [
  { name: 'XC27 — Ascenso, planeo y pilones', tag: 'XtraChallenge 2027', updated: 'ahora', score: 0, status: 'Anteproyecto' },
  { name: 'XC26 — Transporte eficiente', tag: 'XtraChallenge', updated: 'hace 2 h', score: 742, status: 'En diseño' },
  { name: 'Ala volante FPV 1.2m', tag: 'I+D', updated: 'ayer', score: 0, status: 'CFD' },
  { name: 'ACC25 — Cargo lifter', tag: 'Air Cargo', updated: 'hace 3 d', score: 0, status: 'Propulsión' },
];

const sims = [
  { tool: 'Propulsion', name: 'GT2826 · APC10x5 · 4S 2200', metric: `${stat.thrustG.toFixed(0)} g · ${stat.current.toFixed(0)} A`, ok: !stat.overCurrent },
  { tool: 'Propulsion', name: 'GT2826 · APC11x5.5 · 4S', metric: 'sobrecorriente', ok: false },
  { tool: 'Competition', name: 'Sensibilidad ronda carga', metric: '+38 pts / +100 g PL', ok: true },
];

const tools = [
  { href: '/xc27', name: 'XtraChallenge 2027', desc: 'Reglamento XC_27 en números: fórmula de ronda, estáticas, inspección técnica, 450 € y calendario.', icon: 'trophy', status: 'Operativo', live: true },
  { href: '/xc27-avion', name: 'Estudio de avión XC27', desc: 'La ronda completa de un avión: despegue, ascenso, planeo y pilones; carga óptima, V-n, centrado y caja.', icon: 'wind', status: 'Operativo', live: true },
  { href: '/propulsion', name: 'Propulsion Designer', desc: 'Motor · hélice · batería · ESC → curvas de empuje, potencia, eficiencia y autonomía.', icon: 'bolt', status: 'Operativo', live: true },
  { href: '/competition', name: 'Mission Simulator', desc: 'Define la misión con variables y pesos; devuelve la mejor planta motriz, perfil alar y aviónica.', icon: 'trophy', status: 'Operativo', live: true },
  { href: '/cfd', name: 'CFD Studio', desc: 'Lifting-Line + drag buildup → polar, L/D y velocidad de equilibrio con el lazo de propulsión.', icon: 'wind', status: 'Operativo', live: true },
  { href: '/team', name: 'Team Hub', desc: 'Kanban, Gantt, wiki técnica y pizarras para tu equipo de ingeniería.', icon: 'users', status: 'Roadmap' },
];

const icons: Record<string,string> = {
  bolt: '<path d="M13 2 4.5 13.5H11l-1 8.5L19.5 10H13z"/>',
  trophy: '<path d="M8 21h8M12 17v4M6 4h12v4a6 6 0 0 1-12 0zM6 6H3v2a4 4 0 0 0 4 4M18 6h3v2a4 4 0 0 1-4 4"/>',
  wind: '<path d="M3 8h11a3 3 0 1 0-3-3M3 16h14a3 3 0 1 1-3 3M3 12h18"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>',
};
---
<AppShell title="Dashboard" subtitle="Resumen de proyectos, rendimiento y herramientas">
  <!-- Hero -->
  <section class="mb-7">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="badge mb-3"><span class="h-1.5 w-1.5 rounded-full bg-success"></span> Suite activa</span>
        <h1 class="text-2xl font-semibold tracking-tight lg:text-3xl">Buenas, Ricardo.</h1>
        <p class="mt-1 max-w-xl text-sm text-muted">Tu plataforma de ingeniería para diseñar, simular y optimizar UAVs. El <strong class="text-fg">Propulsion Designer</strong> está totalmente operativo con física real.</p>
      </div>
      <div class="flex gap-2">
        <a href="/xc27-avion" class="btn btn-primary">Estudiar avión XC27</a>
        <a href="/competition" class="btn">Optimizar competición</a>
      </div>
    </div>
  </section>

  <!-- KPIs -->
  <section class="mb-7 grid grid-cols-2 gap-3 lg:grid-cols-4">
    <StatCard label="Proyectos activos" value="3" delta="XC26 líder a 742 pts" trend="up" accent />
    <StatCard label="Empuje estático ref." value={stat.thrustG.toFixed(0)} unit="g" delta={`${stat.gPerW.toFixed(2)} g/W · ${stat.current.toFixed(0)} A`} trend="up" />
    <StatCard label="Autonomía crucero" value={cruise.enduranceMin.toFixed(1)} unit="min" delta={`${cruise.rangeKm.toFixed(1)} km @ 16 m/s`} trend="flat" />
    <StatCard label="Catálogo" value={(MOTORS.length+PROPS.length+BATTERIES.length).toString()} unit="comp." delta="motores · hélices · baterías" trend="flat" />
  </section>

  <div class="grid gap-5 lg:grid-cols-3">
    <!-- Tools -->
    <section class="lg:col-span-2">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold">Herramientas</h2>
        <span class="text-[11px] text-subtle">{tools.length} módulos</span>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {tools.map((t) => (
          <a href={t.href} class="card group p-4 transition hover:border-accent/40 hover:shadow-pop">
            <div class="flex items-start justify-between">
              <div class="grid h-9 w-9 place-items-center rounded-lg bg-surface2 text-accent">
                <svg width="18" height="18" viewBox="0 0 24 24" fill={t.icon==='bolt'?'currentColor':'none'} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} />
              </div>
              <span class={`badge ${t.live ? '!text-success !border-success/30 bg-success/10' : ''}`}>{t.status}</span>
            </div>
            <div class="mt-3 text-[13px] font-semibold group-hover:text-accent">{t.name}</div>
            <p class="mt-1 text-[12px] leading-relaxed text-muted">{t.desc}</p>
          </a>
        ))}
      </div>

      <!-- Recent projects -->
      <div class="mt-5 mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold">Proyectos recientes</h2>
        <a href="/team" class="text-[11px] text-accent hover:underline">Ver todos</a>
      </div>
      <div class="card divide-y divide-border overflow-hidden">
        {projects.map((p) => (
          <div class="flex items-center gap-3 px-4 py-3 transition hover:bg-surface2">
            <div class="grid h-8 w-8 place-items-center rounded-md bg-surface2 font-mono text-[11px] text-muted">{p.name.slice(0,2).toUpperCase()}</div>
            <div class="min-w-0 flex-1">
              <div class="truncate text-[13px] font-medium">{p.name}</div>
              <div class="text-[11px] text-subtle">{p.tag} · {p.updated}</div>
            </div>
            <span class="badge">{p.status}</span>
            {p.score > 0 && <div class="hidden font-mono text-sm tabular text-fg sm:block">{p.score}<span class="text-subtle text-[10px]">/1000</span></div>}
          </div>
        ))}
      </div>
    </section>

    <!-- Side column -->
    <section class="space-y-5">
      <div>
        <h2 class="mb-3 text-sm font-semibold">Simulaciones recientes</h2>
        <div class="card divide-y divide-border overflow-hidden">
          {sims.map((s) => (
            <div class="flex items-center gap-3 px-4 py-3">
              <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${s.ok ? 'bg-success' : 'bg-danger'}`}></span>
              <div class="min-w-0 flex-1">
                <div class="truncate text-[12px] font-medium">{s.name}</div>
                <div class="text-[11px] text-subtle">{s.tool}</div>
              </div>
              <div class={`font-mono text-[11px] ${s.ok ? 'text-muted' : 'text-danger'}`}>{s.metric}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="card p-4">
        <h2 class="mb-1 text-sm font-semibold">Accesos rápidos</h2>
        <p class="mb-3 text-[11px] text-subtle">Atajos a las acciones más usadas.</p>
        <div class="space-y-1.5">
          <a href="/propulsion" class="nav-link"><span class="flex-1">⚡ Calcular tren propulsivo</span><span class="kbd">P</span></a>
          <a href="/competition" class="nav-link"><span class="flex-1">🏆 Simular y optimizar una misión</span><span class="kbd">C</span></a>
          <a href="/database" class="nav-link"><span class="flex-1">🔩 Explorar catálogo</span><span class="kbd">D</span></a>
          <a href="/copilot" class="nav-link"><span class="flex-1">✨ Preguntar al copiloto</span><span class="kbd">K</span></a>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="border-b border-border bg-surface2/50 px-4 py-2.5 text-[11px] font-semibold uppercase tracking-wide text-subtle">Reglamento activo</div>
        <div class="space-y-2 p-4 text-[12px]">
          <div class="flex justify-between"><span class="text-muted">Competición</span><a href="/xc27" class="font-medium text-accent hover:underline">XtraChallenge 2027</a></div>
          <div class="flex justify-between"><span class="text-muted">Motor obligatorio</span><span class="font-mono text-[11px]">GT2820/06 985KV</span></div>
          <div class="flex justify-between"><span class="text-muted">Batería máx.</span><span class="font-mono text-[11px]">{XC27_LIMITS.maxCells}S · {XC27_LIMITS.maxVoltage} V</span></div>
          <div class="flex justify-between"><span class="text-muted">Caja de transporte</span><span class="font-mono text-[11px]">≤ {XC27_LIMITS.boxSumMm} mm de suma</span></div>
          <div class="flex justify-between"><span class="text-muted">Presupuesto</span><span class="font-mono text-[11px]">≤ {XC27_LIMITS.budgetEur} €</span></div>
          <div class="flex justify-between"><span class="text-muted">Puntuación máx.</span><span class="font-mono text-[11px]">250 + 750 pts</span></div>
          {nextDeadline && <div class="flex justify-between border-t border-border pt-2"><span class="text-muted">{nextDeadline.label}</span><span class="font-mono text-[11px]">{nextDeadline.date.split('-').reverse().join('/')}</span></div>}
        </div>
      </div>
    </section>
  </div>
</AppShell>
